# Copy to application-local.yml and set environment variables; never commit credentials or keys.
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=jwtmvc;encrypt=true;trustServerCertificate=true
# DB_USERNAME=your_user
# DB_PASSWORD=your_password
# JWT_PRIVATE_KEY_PATH=C:/secure/keys/private.pem
# JWT_PUBLIC_KEY_PATH=C:/secure/keys/public.pem
